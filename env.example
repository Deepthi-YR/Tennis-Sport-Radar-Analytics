# Get the key from https://console.sportradar.com/signup
SPORTRADAR_API_KEY=replace_with_your_key

# Use SQLite for the quickest start, or replace with a PostgreSQL/MySQL URL.
DATABASE_URL=sqlite:///tennis_analytics.db

# SportRadar Tennis v3 API base URL. Confirm the access level/version enabled for your key.
SPORTRADAR_BASE_URL=https://api.sportradar.com/tennis/trial/v3/en
